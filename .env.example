# Configuración de la Aplicación
APP_NAME=FastAPI Backend
APP_VERSION=0.1.0
ENVIRONMENT=production

# Base de Datos
DATABASE_URL=postgresql://user:password@host:port/database

# Seguridad
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_INTENTOS=5
OTP_REENVIO_SEGUNDOS=60
# Temporal: Gmail/Outlook. Cuando tengas el dominio institucional, reemplaza esta lista.
CORREOS_INSTITUCIONALES=gmail.com,outlook.com,hotmail.com,live.com,iudc.edu.co,universitariadecolombia.edu.co

# SMTP para enviar el código OTP (Gmail: use contraseña de aplicación, no la clave de la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=calidad.iudc@gmail.com
SMTP_PASSWORD=
SMTP_FROM=calidad.iudc@gmail.com
SMTP_USE_TLS=true

# CORS - Dominios permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://front-react-puce-three.vercel.app

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=imagenes
