# Configuración de la Aplicación
APP_NAME=FastAPI Backend
APP_VERSION=0.1.0
ENVIRONMENT=production

# Base de Datos
DATABASE_URL=postgresql://user:password@host:port/database

# Seguridad
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_INTENTOS=5
OTP_REENVIO_SEGUNDOS=60
# Solo Gmail u Outlook.
CORREOS_INSTITUCIONALES=gmail.com,outlook.com,hotmail.com,live.com

# SMTP (en Render está bloqueado). OTP: Brevo por HTTPS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=calidad.iudc@gmail.com
SMTP_PASSWORD=
SMTP_FROM=calidad.iudc@gmail.com
SMTP_USE_TLS=true
RESEND_API_KEY=
RESEND_FROM=
# Obligatorio en Render para que el OTP llegue a todos los Gmail/Outlook.
BREVO_API_KEY=
BREVO_FROM=calidad.iudc@gmail.com

# CORS - Dominios permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://front-react-puce-three.vercel.app

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=imagenes
